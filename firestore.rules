rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Solo usuarios autenticados pueden leer las lecturas
    match /readings/{readingId} {
      allow read: if request.auth != null;
      // Solo Cloud Functions pueden escribir (desde el backend)
      allow write: if false;
    }

    // Solo usuarios autenticados pueden leer los dispositivos
    match /devices/{deviceId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
